{
  "name": "ap-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "bin": { "ap": "src/entrypoints/cli.ts" },
  "scripts": {
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
